#!/usr/bin/env bash
# Runs before every `git push`. Catches unit + E2E failures locally so they
# never reach CI. Playwright's webServer config auto-starts pnpm dev if needed.
set -euo pipefail

# Windows Git Bash/MSYS2 sets MSYSTEM (WSL2's own bash never does). Node/pnpm
# are kept in WSL2 only, by design -- see
# specs/backlog/pre-push-hook-wsl-delegation.md for the empirical basis of
# every choice below (path translation method, -ic shell flags, -d ubuntu).
# Re-invoke this same hook script inside WSL2 instead of trying to run pnpm
# directly in Git Bash, where it doesn't exist.
if [ -n "${MSYSTEM:-}" ]; then
  if ! command -v wsl.exe >/dev/null 2>&1; then
    echo "error: wsl.exe not found on PATH -- install WSL2, or push from inside a WSL2 terminal instead." >&2
    exit 1
  fi

  WIN_TOPLEVEL="$(git rev-parse --show-toplevel)"
  WSL_TOPLEVEL="$(wsl.exe -d ubuntu wslpath -a "$WIN_TOPLEVEL")" || {
    echo "error: failed to translate Windows path '$WIN_TOPLEVEL' to a WSL2 path via wslpath" >&2
    exit 1
  }

  cd "$WIN_TOPLEVEL"
  # -ic (interactive, not login) is the only flag combination confirmed to
  # put pnpm (nvm-managed) on PATH without also printing WSL's MOTD banner
  # on every push.
  scripts/time-cmd.sh pre-push-wsl-delegate -- \
    wsl.exe -d ubuntu -e bash -ic "cd '$WSL_TOPLEVEL' && .githooks/pre-push"
  exit $?
fi

cd "$(git rev-parse --show-toplevel)"
REPO="$(pwd)"

run_checks() {
  echo "▶ pre-push: running unit tests..."
  scripts/time-cmd.sh pre-push-unit -- pnpm --filter @linkml-editor/core test

  echo "▶ pre-push: running E2E tests..."
  scripts/time-cmd.sh pre-push-e2e -- pnpm --filter @linkml-editor/web test:e2e
}

# node_modules relocation to native disk (see
# specs/backlog/test-timing-instrumentation-and-reliability.md, "Del 2c"):
# bind-mounting node_modules onto native ext4 eliminates the vitest
# worker-timeout flake and cuts local test time by an order of magnitude on
# this WSL2/drvfs host, confirmed 5/5 reliable via unprivileged user+mount
# namespaces (`unshare --mount --user --map-root-user`) -- no sudo needed.
# Only applied to paths that are currently plain directories; a path that's
# already a symlink (from scripts/setup-native-dev.sh's separate,
# interactive-dev-only relocation) is left untouched, since it already
# points off the slow disk and there's nothing to gain by re-mounting it.
NM_PATHS=(node_modules packages/core/node_modules packages/web/node_modules)
NEEDS_BIND=""
for p in "${NM_PATHS[@]}"; do
  [ -L "$REPO/$p" ] || NEEDS_BIND="$NEEDS_BIND $p"
done

if [ -n "$NEEDS_BIND" ] && command -v unshare >/dev/null 2>&1 && unshare --mount --user --map-root-user true 2>/dev/null; then
  export REPO NEEDS_BIND
  export -f run_checks
  unshare --mount --user --map-root-user bash -c '
    set -euo pipefail
    cd "$REPO"
    NATIVE_NM="$HOME/.cache/linkml-editor-pre-push-nm"
    for p in $NEEDS_BIND; do
      native="$NATIVE_NM/$(echo "$p" | tr "/" "_")"
      mkdir -p "$native" "$p"
      mount --bind "$native" "$p"
    done
    scripts/time-cmd.sh pre-push-install -- pnpm install --frozen-lockfile
    run_checks
  '
else
  # Fallback: unprivileged mount namespaces unavailable, or node_modules is
  # already fully relocated via symlink (nothing left to bind-mount) -- just
  # run normally.
  pnpm install --frozen-lockfile
  run_checks
fi

echo "✓ pre-push checks passed (timing: test-timing/containers.log)"
